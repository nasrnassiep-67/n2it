{
  "name": "n2it-phone-desktop",
  "version": "0.2.11",
  "description": "N2IT Phone desktop client (WebRTC softphone over WSS to FusionPBX)",
  "main": "src/main.js",
  "scripts": {
    "bundle": "npx --yes esbuild@0.24.0 node_modules/jssip/lib/JsSIP.js --bundle --platform=browser --format=iife --global-name=JsSIP --minify --outfile=src/vendor/jssip.min.js",
    "prestart": "npm run bundle",
    "start": "electron .",
    "predist": "npm run bundle",
    "dist": "electron-builder --win nsis",
    "predist:store": "npm run bundle",
    "dist:store": "electron-builder --win appx",
    "predist:linux": "npm run bundle",
    "dist:linux": "electron-builder --linux AppImage deb pacman",
    "predist:mac": "npm run bundle",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:mac:signed": "CSC_NAME=\"Nasr Nassiep (8URJCQ48GM)\" npm run dist:mac && node build/notarise.js"
  },
  "dependencies": {
    "jssip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "za.co.n2it.softphone.desktop",
    "productName": "N2IT Phone",
    "files": [
      "src/**"
    ],
    "afterPack": "build/after-pack.js",
    "win": {
      "target": "nsis"
    },
    "appx": {
      "identityName": "N2ITSolutions.N2ITPhone",
      "publisher": "CN=7501823B-3E22-4B8F-87E3-1321277C359B",
      "publisherDisplayName": "N2IT Solutions",
      "displayName": "N2IT Phone",
      "applicationId": "N2ITPhone",
      "backgroundColor": "#FFFFFF",
      "languages": [
        "en-US"
      ],
      "artifactName": "n2it-phone-store.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "N2IT Phone needs the microphone for calls."
      },
      "artifactName": "n2it-phone-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Telephony",
      "maintainer": "N2IT <support@n2it.co.za>"
    },
    "protocols": [
      {
        "name": "Phone call",
        "schemes": [
          "tel",
          "callto",
          "sip"
        ]
      },
      {
        "name": "N2IT Phone notification",
        "schemes": [
          "n2itphone"
        ]
      }
    ],
    "nsis": {
      "include": "build/installer.nsh"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "at-spi2-core",
        "xdg-utils",
        "util-linux-libs"
      ]
    }
  },
  "author": {
    "name": "N2IT",
    "email": "support@n2it.co.za"
  },
  "homepage": "https://n2it.co.za"
}
