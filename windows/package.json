{
  "name": "n2it-phone-desktop",
  "version": "0.1.8",
  "description": "N2IT Phone desktop client (WebRTC softphone over WSS to FusionPBX)",
  "main": "src/main.js",
  "scripts": {
    "bundle": "npx --yes esbuild@0.24.0 node_modules/jssip/lib/JsSIP.js --bundle --platform=browser --format=iife --global-name=JsSIP --minify --outfile=src/vendor/jssip.min.js",
    "prestart": "npm run bundle",
    "start": "electron .",
    "predist": "npm run bundle",
    "dist": "electron-builder --win nsis",
    "predist:linux": "npm run bundle",
    "dist:linux": "electron-builder --linux AppImage deb",
    "predist:mac": "npm run bundle",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "dependencies": {
    "jssip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "za.co.n2it.softphone.desktop",
    "productName": "N2IT Phone",
    "files": [
      "src/**"
    ],
    "afterPack": "build/adhoc-sign.js",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "N2IT Phone needs the microphone for calls."
      },
      "artifactName": "n2it-phone-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Telephony",
      "maintainer": "N2IT <support@n2it.co.za>"
    },
    "protocols": [
      {
        "name": "Phone call",
        "schemes": [
          "tel",
          "callto",
          "sip"
        ]
      }
    ],
    "nsis": {
      "include": "build/installer.nsh"
    }
  },
  "author": {
    "name": "N2IT",
    "email": "support@n2it.co.za"
  },
  "homepage": "https://n2it.co.za"
}
